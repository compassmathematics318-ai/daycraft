# Optional provider overrides (PowerShell environment or launcher-loaded .env)
SCHEDULE_BUILDER_PORT=8765
GEOCODER_URL=https://nominatim.openstreetmap.org/search
WALKING_ROUTER_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
# Set to 1 to disable remote geocoding/routing. Map tiles still need Internet.
SCHEDULE_BUILDER_OFFLINE=0
# Optional tile provider overrides (used when building the frontend):
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Optional absolute paths; defaults are project/data.
# SCHEDULE_BUILDER_DB=C:\Projects\schedule_builder\data\schedule_builder.db
# SCHEDULE_BUILDER_ROUTE_CACHE=C:\Projects\schedule_builder\data\travel_cache.sqlite
